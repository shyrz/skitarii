# 复制为 .env 并填入真实值。.env 不进版本库。

# Telegram Bot，BotFather 生成。需在 BotFather 关闭隐私模式，否则读不到全群消息。
BOT_TOKEN=

# Postgres 连接串，postgres.js 格式。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skitarii

# OpenAI 兼容协议的云端 LLM（BYOK）。baseUrl 指向服务根，不含 /chat/completions。
# 三项缺任意一项即视为「未配置复核」：灰色地带消息按待复核处理，审核链路照常工作。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 复核请求超时（毫秒）。审核在消息路径上，超时即当作复核不可用。
LLM_TIMEOUT_MS=30000

# Telegram 回调用 webhook secret_token，与 setWebhook 时提交的值一致。
# server 用它校验 X-Telegram-Bot-Api-Secret-Token；bot 长轮询模式不需要。
WEBHOOK_SECRET=

# Mini App 对外地址，用于组装申诉按钮链接（${MINI_APP_URL}?startapp=${decisionId}）。
# 想让用户在 Telegram 内直接打开并带上 initData，可填 Mini App 直链，例如 https://t.me/<bot>/<app>；
# Telegram 会把 startapp 的值转成页面的 start_param。
MINI_APP_URL=https://example.com

# 申诉负责人（Telegram 用户 id）。新申诉会私聊通知该用户，只有该用户能「维持 / 撤销」。
# 获取方式：与 bot 私聊后看日志，或用 @userinfobot 一类工具查询自己的数字 id。
OWNER_USER_ID=

# owner 判定 feed：每条过审消息（含放行）私聊 owner 一条判定摘要。测试期默认开启，置 false 关闭。
# 只接受 true / false；未设置等同 true。
OWNER_DEBUG_NOTIFY=true

# 维护任务（日聚合重算 + 保留期清理）的执行间隔（毫秒），默认 1 小时。
MAINTENANCE_INTERVAL_MS=3600000
